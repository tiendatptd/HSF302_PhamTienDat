<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hsf302.ui.StudentController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Bảng hiển thị danh sách sinh viên -->
    <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colFirst" text="First Name" prefWidth="150"/>
            <TableColumn fx:id="colLast" text="Last Name" prefWidth="150"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
        </columns>
    </TableView>

    <!-- Form nhập thông tin thêm mới -->
    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="txtFirstName" promptText="First Name"/>
        <TextField fx:id="txtLastName" promptText="Last Name"/>
        <TextField fx:id="txtEmail" promptText="Email"/>
        <Button text="Add Student" onAction="#addStudent"/>
    </HBox>
</VBox>