<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="com.hsf302.demologin.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="ĐĂNG NHẬP" />

    <TextField fx:id="usernameField" promptText="Tên đăng nhập" />
    <PasswordField fx:id="passwordField" promptText="Mật khẩu" />

    <Button onAction="#onLoginButtonClick" text="Login" />

    <Label fx:id="welcomeText" />
</VBox>