<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hsf302.ui.StudentController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Thanh tìm kiếm -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="Nhập tên hoặc email để tìm..." prefWidth="250"/>
        <Button text="Search" onAction="#searchStudent"/>
        <Button text="Reset" onAction="#resetSearch"/>
    </HBox>

    <!-- Bảng hiển thị danh sách sinh viên -->
    <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colFirst" text="Tên" prefWidth="150"/>
            <TableColumn fx:id="colLast" text="Họ" prefWidth="150"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
        </columns>
    </TableView>

    <!-- Form nhập thông tin và các nút chức năng -->
    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="txtFirstName" promptText="Tên"/>
        <TextField fx:id="txtLastName" promptText="Họ"/>
        <TextField fx:id="txtEmail" promptText="Email"/>
        <Button text="Add" onAction="#addStudent"/>
        <Button text="Update" onAction="#updateStudent"/>
        <Button text="Delete" onAction="#deleteStudent"/>
    </HBox>
</VBox>